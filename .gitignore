# ---------------------------------------------------------------------------
# Build output - produced by the scripts, never committed.
# ---------------------------------------------------------------------------
dist/

# web\ is generated by make-web.ps1 from app\renderer (index.html, web-api.js,
# engine.js and .nojekyll are hand-written and stay in git).
web/app.js
web/style.css
web/icon.png
web/vendor/

# ---------------------------------------------------------------------------
# Vendored runtime / toolchain - keep them locally, they are far too large for
# git (runtime\electron.exe alone is 235 MB, over GitHub's file limit) and a
# Pages workflow only needs app\renderer.
# ---------------------------------------------------------------------------
runtime/
tools/node/
tools/qpdf/

# ---------------------------------------------------------------------------
# Generated test fixtures (test\gen-cases.js rewrites these on every run)
# ---------------------------------------------------------------------------
test/case-*.pdf

# ---------------------------------------------------------------------------
# Editor / OS noise
# ---------------------------------------------------------------------------
.vs/
*.user
*.suo
*.log
Thumbs.db
Desktop.ini

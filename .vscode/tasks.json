{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build single executable",
      "detail": "Packs app + runtime + qpdf into dist\\PDFStreamEditor.exe (self-extracting)",
      "type": "shell",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\build.ps1"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    }
  ]
}
